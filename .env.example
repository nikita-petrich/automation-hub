# =============================================================================
# automation-hub — environment configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in the values:   cp .env.example .env
# NEVER commit the real .env. (With CI/CD, .env is rendered on the VPS from the
# GitHub `production` Environment — see docs/ci-cd.md.)
# =============================================================================

# --- Public endpoint (served by your existing reverse proxy) -----------------

# Hostname n8n is served on. Your reverse proxy terminates TLS for it and routes
# it to automation-hub-n8n:5678. Add to the proxy's SITES + ALLOWED_DOMAINS.
DOMAIN=n8n.example.com

# Name of the reverse proxy's shared Docker network that n8n joins.
# (Your reverse-proxy stack's compose defaults this to "example-net".)
PROXY_NETWORK=example-net

# --- n8n ---------------------------------------------------------------------

# Pinned n8n image tag.
N8N_IMAGE_TAG=2.31.4

# 32-byte hex key encrypting stored credentials. Generate once: openssl rand -hex 32
# WARNING: changing it after credentials exist makes them unreadable.
N8N_ENCRYPTION_KEY=

# --- n8n Public API (used by scripts/deploy.ts & backup.ts) ------------------

# API key created in the UI: Settings -> n8n API -> Create an API key.
N8N_API_KEY=

# The deploy script talks to n8n locally over the loopback-published port.
N8N_API_URL=http://127.0.0.1:5678

# Credential ID of the Google OAuth2 credential you create in n8n (optional).
# If set, deploy wires it into every HTTP node and activates the workflow.
GOOGLE_OAUTH_CRED_ID=

# --- birthday-sync workflow --------------------------------------------------

CALENDAR_ID=715ae8ec20ec8c3eb509fc5e16341ec12845aed2e102a0a26dd1e559322ce0ed@group.calendar.google.com
BIRTHDAY_SYNC_SCHEDULE=0 6 * * *
SHOW_BIRTH_YEAR=true
