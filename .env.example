# =============================================================================
# automation-hub — environment configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:   cp .env.example .env
# The real `.env` holds secrets and is gitignored — NEVER commit it.
# =============================================================================

# --- Public endpoint ---------------------------------------------------------

# Fully-qualified hostname that serves the n8n editor + webhooks over HTTPS.
# Caddy requests a Let's Encrypt certificate for EXACTLY this name, so its
# A record must point at this server's public IP.
DOMAIN=n8n.example.com

# --- Container image tags (pinned for reproducibility) -----------------------

# n8n image tag. Bump this when you want to upgrade, then re-run `deploy`.
N8N_IMAGE_TAG=2.31.4
# Caddy image tag.
CADDY_IMAGE_TAG=2-alpine

# --- n8n security ------------------------------------------------------------

# 32-byte hex key that encrypts stored credentials at rest.
# Generate ONCE with:   openssl rand -hex 32
# WARNING: if you change this after credentials exist, they become unreadable.
N8N_ENCRYPTION_KEY=

# --- n8n Public API (used by scripts/deploy.ts & backup.ts) ------------------

# API key created in the UI: Settings -> n8n API -> Create an API key.
N8N_API_KEY=

# Base URL the deploy/backup scripts talk to.
# - From your laptop:      https://n8n.example.com
# - From the server host:  http://localhost:5678  (only if you temporarily
#                          publish the port; by default it is not exposed, so
#                          prefer running the scripts against the public URL).
N8N_API_URL=https://n8n.example.com

# Credential ID of the Google OAuth2 credential you create in n8n (optional).
# If set, `deploy` wires it into every HTTP Request node automatically so you
# don't have to select the credential by hand. Find the ID in the URL when you
# open the credential:  https://<domain>/home/credentials/<THIS-ID>
GOOGLE_OAUTH_CRED_ID=

# --- birthday-sync workflow --------------------------------------------------

# Target Google Calendar the birthdays are written to (a dedicated secondary
# calendar — see docs/manual-setup.md for how to create it and read its ID).
CALENDAR_ID=715ae8ec20ec8c3eb509fc5e16341ec12845aed2e102a0a26dd1e559322ce0ed@group.calendar.google.com

# Cron expression for the daily full sweep (n8n Schedule Trigger).
# Default: every day at 06:00 (server timezone = Europe/Berlin).
BIRTHDAY_SYNC_SCHEDULE=0 6 * * *

# When true and a birth year is known, the event title shows the upcoming age,
# e.g. "🎂 Anna (turning 40)". Set to false for name-only titles.
SHOW_BIRTH_YEAR=true
