# --- Secrets / local environment ---------------------------------------
# The real environment file is generated by you and must never be committed.
.env
*.env
!.env.example

# --- Node ----------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- n8n / local runtime data -------------------------------------------
# SQLite database and the n8n home directory live in Docker volumes, but
# guard against accidental local copies ending up in the repo.
*.sqlite
*.sqlite3
.n8n/
n8n_data/

# --- Safety backups produced by scripts/backup.ts -----------------------
# These are point-in-time exports of the LIVE instance (may contain data),
# kept locally for disaster recovery only. The repo stays the source of truth.
backups/

# --- Deploy bookkeeping --------------------------------------------------
.deploy-state.json

# --- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
dist/
