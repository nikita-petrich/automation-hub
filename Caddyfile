# =============================================================================
# Caddy reverse proxy for the automation-hub n8n instance.
#
# Caddy automatically obtains and renews a Let's Encrypt certificate for
# {$DOMAIN} on first request, then proxies all traffic to the internal n8n
# container on port 5678. The domain is injected from the DOMAIN variable in
# `.env` (see docker-compose.yml -> caddy.environment).
#
# Requirements for the automatic certificate to succeed:
#   - Ports 80 and 443 reachable from the public internet.
#   - {$DOMAIN} resolves (A record) to this server's public IP.
# =============================================================================

{$DOMAIN} {
	reverse_proxy n8n:5678
}
